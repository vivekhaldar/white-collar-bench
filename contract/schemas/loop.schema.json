{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wcb:contract/loop",
  "title": "Loop record front matter",
  "type": "object",
  "required": [
    "id",
    "type",
    "kind",
    "title",
    "owner",
    "counterparty",
    "status",
    "accepted",
    "evidence",
    "created",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^loops/[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "const": "loop"
    },
    "kind": {
      "enum": [
        "task",
        "ask",
        "decision"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "pattern": "^people/[a-z0-9][a-z0-9-]*$"
    },
    "counterparty": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^people/[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "open",
        "waiting",
        "blocked",
        "done",
        "dropped",
        "reversed"
      ]
    },
    "accepted": {
      "type": "boolean"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "basis",
          "date"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z]{2}-[A-Za-z0-9-]+$"
          },
          "basis": {
            "enum": [
              "sent",
              "received",
              "reported",
              "scheduled",
              "inferred"
            ]
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "project": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^projects/[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "due": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "others": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^people/[a-z0-9][a-z0-9-]*$"
      }
    },
    "outcome": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "decided_on": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reversed_on": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "task",
              "ask"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "counterparty": {
            "type": "string",
            "pattern": "^people/[a-z0-9][a-z0-9-]*$"
          },
          "status": {
            "enum": [
              "open",
              "waiting",
              "blocked",
              "done",
              "dropped"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          },
          "status": {
            "const": "done"
          }
        }
      },
      "then": {
        "required": [
          "outcome",
          "decided_on"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          },
          "status": {
            "const": "reversed"
          }
        }
      },
      "then": {
        "required": [
          "reversed_on"
        ]
      }
    }
  ],
  "additionalProperties": true
}
