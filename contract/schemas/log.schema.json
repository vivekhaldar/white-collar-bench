{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wcb:contract/log",
  "title": "Daily log front matter",
  "type": "object",
  "required": [
    "id",
    "type",
    "date"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^logs/\\d{4}-\\d{2}-\\d{2}$"
    },
    "type": {
      "const": "log"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": true
}
