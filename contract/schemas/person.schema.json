{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wcb:contract/person",
  "title": "Person record front matter",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "aliases",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^people/[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "const": "person"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "org": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^orgs/[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "role": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "email": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "relationship": {
      "anyOf": [
        {
          "enum": [
            "manager",
            "report",
            "peer",
            "stakeholder",
            "executive",
            "assistant",
            "vendor",
            "partner",
            "candidate",
            "advisor",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
