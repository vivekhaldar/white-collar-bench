{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wcb:contract/project",
  "title": "Project record front matter",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "aliases",
    "status",
    "owner",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^projects/[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "const": "project"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "dormant",
        "done",
        "cancelled",
        "merged"
      ]
    },
    "owner": {
      "type": "string",
      "pattern": "^people/[a-z0-9][a-z0-9-]*$"
    },
    "people": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^people/[a-z0-9][a-z0-9-]*$"
      }
    },
    "orgs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^orgs/[a-z0-9][a-z0-9-]*$"
      }
    },
    "target_date": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "parent": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^projects/[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "split_into": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^projects/[a-z0-9][a-z0-9-]*$"
      }
    },
    "merged_into": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^projects/[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "merged_into"
        ],
        "properties": {
          "merged_into": {
            "type": "string",
            "pattern": "^projects/[a-z0-9][a-z0-9-]*$"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "merged"
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
