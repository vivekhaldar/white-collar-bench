{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wcb:contract/org",
  "title": "Organization record front matter",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "aliases",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^orgs/[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "const": "org"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "kind": {
      "anyOf": [
        {
          "enum": [
            "internal",
            "vendor",
            "customer",
            "partner",
            "other"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "domain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true
}
