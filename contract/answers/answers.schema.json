{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wcb:answers",
  "title": "white-collar-bench answers file (.wcb/answers.json)",
  "description": "A JSON object mapping each question ID to an answer. The answer's `type` must equal the question's `type`. Set `abstain: true` (and omit other fields) when the store does not support an answer.",
  "type": "object",
  "additionalProperties": {
    "oneOf": [
      {
        "$ref": "#/$defs/point"
      },
      {
        "$ref": "#/$defs/list"
      },
      {
        "$ref": "#/$defs/status"
      },
      {
        "$ref": "#/$defs/brief"
      },
      {
        "$ref": "#/$defs/change"
      },
      {
        "$ref": "#/$defs/temporal"
      },
      {
        "$ref": "#/$defs/priority"
      }
    ]
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "type",
        "abstain"
      ],
      "properties": {
        "type": {
          "const": "point"
        },
        "abstain": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "cites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Artifact IDs (e.g. em-0193) and, in Track A, store record IDs or paths (e.g. loops/send-scorecard)."
        }
      },
      "if": {
        "properties": {
          "abstain": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "value"
        ]
      },
      "additionalProperties": true
    },
    "list": {
      "type": "object",
      "required": [
        "type",
        "abstain"
      ],
      "properties": {
        "type": {
          "const": "list"
        },
        "abstain": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "counterparty": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Name of the other person"
              },
              "direction": {
                "enum": [
                  "i_owe",
                  "owed_to_me",
                  "other",
                  null
                ]
              },
              "status": {
                "enum": [
                  "open",
                  "waiting",
                  "blocked",
                  "done",
                  "dropped",
                  null
                ]
              },
              "due": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Artifact IDs (e.g. em-0193) and, in Track A, store record IDs or paths (e.g. loops/send-scorecard)."
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "abstain": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "items"
        ]
      },
      "additionalProperties": true
    },
    "status": {
      "type": "object",
      "required": [
        "type",
        "abstain"
      ],
      "properties": {
        "type": {
          "const": "status"
        },
        "abstain": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "summary": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Artifact IDs (e.g. em-0193) and, in Track A, store record IDs or paths (e.g. loops/send-scorecard)."
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "abstain": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "summary"
        ]
      },
      "additionalProperties": true
    },
    "brief": {
      "type": "object",
      "required": [
        "type",
        "abstain"
      ],
      "properties": {
        "type": {
          "const": "brief"
        },
        "abstain": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "summary": {
          "type": "string"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Artifact IDs (e.g. em-0193) and, in Track A, store record IDs or paths (e.g. loops/send-scorecard)."
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "abstain": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "summary"
        ]
      },
      "additionalProperties": true
    },
    "change": {
      "type": "object",
      "required": [
        "type",
        "abstain"
      ],
      "properties": {
        "type": {
          "const": "change"
        },
        "abstain": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "date": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Artifact IDs (e.g. em-0193) and, in Track A, store record IDs or paths (e.g. loops/send-scorecard)."
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "abstain": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "items"
        ]
      },
      "additionalProperties": true
    },
    "temporal": {
      "type": "object",
      "required": [
        "type",
        "abstain"
      ],
      "properties": {
        "type": {
          "const": "temporal"
        },
        "abstain": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "text": {
          "type": "string"
        },
        "cites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Artifact IDs (e.g. em-0193) and, in Track A, store record IDs or paths (e.g. loops/send-scorecard)."
        }
      },
      "if": {
        "properties": {
          "abstain": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "date"
        ]
      },
      "additionalProperties": true
    },
    "priority": {
      "type": "object",
      "required": [
        "type",
        "abstain"
      ],
      "properties": {
        "type": {
          "const": "priority"
        },
        "abstain": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "due": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "why": {
                "type": "string"
              },
              "cites": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Artifact IDs (e.g. em-0193) and, in Track A, store record IDs or paths (e.g. loops/send-scorecard)."
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "abstain": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "items"
        ]
      },
      "additionalProperties": true
    }
  }
}
