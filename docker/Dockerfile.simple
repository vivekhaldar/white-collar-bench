# An agent image for container-isolated sessions: the wcb package (for the simple harness and
# the baselines) and nothing else. Worlds and gold are NOT copied (see .dockerignore).
#
#   docker build -f docker/Dockerfile.simple -t wcb-simple .
#   WCB_AGENT_IMAGE=wcb-simple WCB_AGENT_CMD="python -m wcb.agents.simple --provider anthropic --model <model-id>" \
#     wcb run --adapter adapters/examples/docker.yaml --world pilot --out runs/docker-simple
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/wcb
COPY pyproject.toml README.md ./
COPY wcb ./wcb
COPY contract ./contract
RUN pip install --no-cache-dir .
WORKDIR /workspace
